# PaperReader 配置示例
# 复制为项目根目录的 paperreader.toml（已被 .gitignore 忽略），
# 或放到 ~/.config/paperreader/config.toml。
# 优先级：环境变量 > 项目 paperreader.toml > 用户配置 > 默认值。

# LLM 接入为标准 OpenAI 兼容三件套：换任何网关只需改这三行。
# 示例：智谱开放平台（默认）
api_base = "https://open.bigmodel.cn/api/paas/v4"
api_key = "sk-..."
model = "glm-4.5"
# model 必须与所选网关的模型 ID 一致（如 OpenRouter 为 "z-ai/glm-4.6" 之类的完整 ID）。

# 出站访问 LLM API 使用的 HTTP 代理（直连可访问时留空即可）
# 示例：proxy = "http://127.0.0.1:10808"
proxy = ""

# 附加请求头（可选，TOML 表；网关有特殊要求时才需要）。
# OpenCode 网关的会话头会按域名自动附加，无需在此配置。
# [extra_headers]
# "X-Custom-Auth" = "xxx"

# 送入 LLM 的论文文本最大字符数（超出时保留首尾、截断中部）
max_chars = 200000

# API 超时（秒），思考型模型生成长文时较慢，建议保持宽裕
timeout = 900

# 论文库与 summary 目录（相对路径基于运行目录，也可用绝对路径）
papers_dir = "papers"
summaries_dir = "summaries"
